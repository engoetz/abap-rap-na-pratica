managed implementation in class zbp_r_chamado unique;
strict ( 2 );
with draft;

define behavior for ZR_Chamado alias Chamado
persistent table zchm_chamado
draft table zchm_chamado_d
lock master total etag LastChangedAt
authorization master ( instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  association _Apontamentos { create; with draft; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validarTitulo;
    validation validarCliente;
  }

  field ( numbering : managed, readonly ) ChamadoUUID;
  field ( readonly ) ChamadoID, Status, HorasTotal, CreatedBy, CreatedAt,
                     LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( features : instance ) Titulo, Cliente, Prioridade, Descricao;

  determination definirStatusInicial on modify { create; }
  determination definirNumero on save { create; }
  determination escalarPrioridade on modify { field HorasTotal; }

  validation validarTitulo on save { create; field Titulo; }
  validation validarCliente on save { create; field Cliente; }

  action ( features : instance ) encerrar result [1] $self;
  action ( features : instance ) encerrarComMotivo parameter ZA_MotivoEncerramento result [1] $self;
  factory action copiar [1];

  side effects
  {
    field HorasTotal affects field Prioridade;
  }

  mapping for zchm_chamado
  {
    ChamadoUUID        = chamado_uuid;
    ChamadoID          = chamado_id;
    Titulo             = titulo;
    Cliente            = cliente;
    Prioridade         = prioridade;
    Status             = status;
    HorasTotal         = horas_total;
    Descricao          = descricao;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZR_Apontamento alias Apontamento
persistent table zchm_apont
draft table zchm_apont_d
lock dependent by _Chamado
authorization dependent by _Chamado
etag master LocalLastChangedAt
{
  update;
  delete;

  determination calcularTotalHoras on modify { create; field Horas; }

  side effects { field Horas affects field _Chamado.HorasTotal; }

  field ( numbering : managed, readonly ) ApontUUID;
  field ( readonly ) ChamadoUUID, CreatedBy, CreatedAt,
                     LastChangedBy, LastChangedAt, LocalLastChangedAt;

  association _Chamado { with draft; }

  mapping for zchm_apont
  {
    ApontUUID          = apont_uuid;
    ChamadoUUID        = chamado_uuid;
    DataApont          = data_apont;
    Horas              = horas;
    Descricao          = descricao;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
