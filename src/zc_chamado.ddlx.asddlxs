@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Chamado',
  typeNamePlural: 'Chamados',
  title: { type: #STANDARD, value: 'Titulo' },
  description: { type: #STANDARD, value: 'ChamadoID' }
}
annotate view ZC_Chamado with
{
  @UI.facet: [
    { id: 'Geral', position: 10,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Geral',
      label: 'Informações gerais' },
    { id: 'Apontamentos', position: 20,
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Apontamentos',
      targetElement: '_Apontamentos' },
    { id: 'Admin', position: 30,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Admin',
      label: 'Dados administrativos' }
  ]
  @UI.hidden: true
  ChamadoUUID;

  @UI.lineItem: [{ position: 10 },
                 { type: #FOR_ACTION, dataAction: 'encerrar', label: 'Encerrar' },
                 { type: #FOR_ACTION, dataAction: 'encerrarComMotivo', label: 'Encerrar com motivo' },
                 { type: #FOR_ACTION, dataAction: 'copiar', label: 'Copiar' }]
  @UI.identification: [{ type: #FOR_ACTION, dataAction: 'encerrar', label: 'Encerrar' },
                       { type: #FOR_ACTION, dataAction: 'encerrarComMotivo', label: 'Encerrar com motivo' },
                       { type: #FOR_ACTION, dataAction: 'copiar', label: 'Copiar' }]
  @UI.fieldGroup: [{ qualifier: 'Geral', position: 10 }]
  @EndUserText.label: 'ID do chamado'
  ChamadoID;

  @UI.lineItem: [{ position: 20 }]
  @UI.fieldGroup: [{ qualifier: 'Geral', position: 20 }]
  @EndUserText.label: 'Título'
  Titulo;

  @UI.lineItem: [{ position: 30 }]
  @UI.selectionField: [{ position: 10 }]
  @UI.fieldGroup: [{ qualifier: 'Geral', position: 30 }]
  Cliente;

  @UI.lineItem: [{ position: 40, criticality: 'PrioridadeCriticidade' }]
  @UI.selectionField: [{ position: 20 }]
  @UI.fieldGroup: [{ qualifier: 'Geral', position: 40,
                     criticality: 'PrioridadeCriticidade' }]
  @UI.textArrangement: #TEXT_ONLY
  @EndUserText.label: 'Prioridade'
  Prioridade;

  @UI.lineItem: [{ position: 50, criticality: 'StatusCriticidade' }]
  @UI.selectionField: [{ position: 30 }]
  @UI.fieldGroup: [{ qualifier: 'Geral', position: 50,
                     criticality: 'StatusCriticidade' }]
  @UI.textArrangement: #TEXT_ONLY
  @EndUserText.label: 'Status'
  Status;

  @UI.lineItem: [{ position: 60 }]
  @UI.fieldGroup: [{ qualifier: 'Geral', position: 60 }]
  @EndUserText.label: 'Total de horas'
  HorasTotal;

  @UI.lineItem: [{ position: 70 }]
  DiasEmAberto;

  @UI.fieldGroup: [{ qualifier: 'Geral', position: 70 }]
  Descricao;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 10 }]
  CreatedBy;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 20 }]
  CreatedAt;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 30 }]
  LastChangedBy;
}
