projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_Chamado alias Chamado
use etag
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action encerrar;
  use action encerrarComMotivo;
  use action copiar;

  use association _Apontamentos { create; with draft; }
}

define behavior for ZC_Apontamento alias Apontamento
{
  use update;
  use delete;

  use association _Chamado { with draft; }
}
